// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===== USER (Admin) =====

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String   // Hashed with bcrypt
  name      String
  role      String   @default("admin")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  posts     Post[]
}

// ===== BLOG POST =====

model Post {
  id               String        @id @default(cuid())
  title            String
  slug             String        @unique
  content          String        @db.Text
  excerpt          String?       @db.Text
  featuredImage    String?
  metaTitle        String?
  metaDescription  String?
  publishStatus    PublishStatus @default(DRAFT)
  publishAt        DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  authorId         String?
  author           User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)
  categories       Category[]    @relation("PostCategories")
  tags             Tag[]         @relation("PostTags")

  @@index([slug])
  @@index([publishStatus])
  @@index([publishAt])
}

enum PublishStatus {
  DRAFT
  PUBLISHED
  SCHEDULED
}

// ===== CATEGORY =====

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?  @db.Text
  posts       Post[]   @relation("PostCategories")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([slug])
}

// ===== TAG =====

model Tag {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  posts     Post[]   @relation("PostTags")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
}

// ===== TREATMENT (Tratamientos dentales) =====

model Treatment {
  id               String   @id @default(cuid())
  title            String
  slug             String   @unique
  description      String   @db.Text
  longDescription  String?  @db.Text
  featuredImage    String?
  icon             String?
  priceRange       String?  // Ej: "800€ - 1.500€"
  duration         String?  // Ej: "1-2 sesiones"
  metaTitle        String?
  metaDescription  String?
  faqItems         Json?    // Array de {question, answer}
  order            Int      @default(0)
  published        Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([slug])
  @@index([published])
}

// ===== PAGE (Páginas estáticas editables) =====

model Page {
  id              String   @id @default(cuid())
  title           String
  slug            String   @unique
  content         String   @db.Text
  metaTitle       String?
  metaDescription String?
  published       Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([slug])
}

// ===== SETTINGS (Configuración global) =====

model Settings {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String   @db.Text
  description String?
  updatedAt   DateTime @updatedAt

  @@index([key])
}

// ===== CONTACT SUBMISSION (Formularios de contacto) =====

model ContactSubmission {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String
  message   String   @db.Text
  treatment String?  // Tratamiento de interés
  status    String   @default("pending") // pending, contacted, converted
  createdAt DateTime @default(now())
  
  @@index([status])
}

// ===== APPOINTMENT REQUEST (Solicitudes de cita) =====

model AppointmentRequest {
  id            String   @id @default(cuid())
  name          String
  email         String
  phone         String
  preferredDate String?
  preferredTime String?
  treatment     String?
  message       String?  @db.Text
  status        String   @default("pending") // pending, confirmed, cancelled
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

// ===== SEO MODULE =====

model SeoSite {
  id            String   @id @default(cuid())
  domain        String   @unique
  gscProperty   String?  // Google Search Console property URL
  countryDefault String  @default("ES")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  keywords      SeoKeyword[]
  ranks         SeoKeywordRankDaily[]
  issues        SeoIssue[]
  recommendations SeoRecommendation[]

  @@index([domain])
}

model SeoKeyword {
  id            String   @id @default(cuid())
  siteId        String
  site          SeoSite  @relation(fields: [siteId], references: [id], onDelete: Cascade)
  keyword       String
  intent        String?  // informational, navigational, transactional, commercial
  targetUrl     String?  // URL objetivo para esta keyword
  tags          String[] // Array de tags para agrupar
  discovered    Boolean  @default(false) // Si fue descubierta automáticamente desde GSC
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  ranks         SeoKeywordRankDaily[]
  volumes       SeoKeywordVolumeMonthly[]

  @@unique([siteId, keyword])
  @@index([siteId])
  @@index([keyword])
  @@index([intent])
}

model SeoKeywordRankDaily {
  id            String   @id @default(cuid())
  siteId        String
  site          SeoSite  @relation(fields: [siteId], references: [id], onDelete: Cascade)
  keywordId     String
  keyword       SeoKeyword @relation(fields: [keywordId], references: [id], onDelete: Cascade)
  date          DateTime @db.Date
  country       String   @default("ES")
  device        String   @default("all") // all, desktop, mobile, tablet
  position      Float?   // Posición promedio ponderada
  clicks        Int      @default(0)
  impressions  Int      @default(0)
  ctr           Float?   // Click-through rate
  pageUrl       String?  // URL que rankea para esta keyword
  
  createdAt     DateTime @default(now())

  @@unique([siteId, keywordId, date, country, device])
  @@index([siteId, date])
  @@index([keywordId, date])
  @@index([date])
}

model SeoKeywordVolumeMonthly {
  id            String   @id @default(cuid())
  keywordId     String
  keyword       SeoKeyword @relation(fields: [keywordId], references: [id], onDelete: Cascade)
  provider      String   // "google_ads", "dataforseo", "ahrefs", "semrush", etc.
  country       String   @default("ES")
  volume        Int?     // Volumen de búsqueda mensual
  competition   String?  // low, medium, high
  cpc           Float?   // Cost per click estimado
  updatedAt     DateTime @default(now())
  
  @@unique([keywordId, provider, country])
  @@index([keywordId])
}

model SeoIssue {
  id            String   @id @default(cuid())
  siteId        String
  site          SeoSite  @relation(fields: [siteId], references: [id], onDelete: Cascade)
  type          String   // "technical", "content", "performance", "indexability", etc.
  severity      String   @default("medium") // critical, high, medium, low
  url           String?
  title         String
  description   String   @db.Text
  evidenceJson  Json?    // Datos adicionales en JSON
  firstSeen     DateTime @default(now())
  lastSeen      DateTime @default(now())
  status        String   @default("open") // open, in_progress, resolved, ignored
  
  recommendations SeoRecommendation[]

  @@index([siteId])
  @@index([type])
  @@index([severity])
  @@index([status])
  @@index([siteId, type, url])
}

model SeoRecommendation {
  id            String   @id @default(cuid())
  siteId        String
  site          SeoSite  @relation(fields: [siteId], references: [id], onDelete: Cascade)
  issueId       String?
  issue         SeoIssue? @relation(fields: [issueId], references: [id], onDelete: SetNull)
  title         String
  rationale     String   @db.Text
  steps         Json     // Array de pasos para implementar
  impactScore   Int      @default(50) // 0-100
  effortScore   Int      @default(50) // 0-100 (menor = más fácil)
  priority      Int      @default(50) // Calculado: f(impact, effort, severity)
  status        String   @default("pending") // pending, in_progress, completed, dismissed
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([siteId])
  @@index([priority])
  @@index([status])
  @@index([siteId, title])
}

// ===== COMPETITOR ANALYSIS =====

model SeoCompetitor {
  id            String   @id @default(cuid())
  siteId        String
  site          SeoSite  @relation(fields: [siteId], references: [id], onDelete: Cascade)
  domain        String
  name          String?  // Nombre de la clínica
  url           String
  enabled       Boolean  @default(true)
  lastAnalyzed  DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  keywords      SeoCompetitorKeyword[]
  rankings      SeoCompetitorRanking[]
  
  @@unique([siteId, domain])
  @@index([siteId])
  @@index([domain])
}

model SeoCompetitorKeyword {
  id            String   @id @default(cuid())
  competitorId  String
  competitor    SeoCompetitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  keyword       String
  position      Float?   // Posición promedio en SERP
  monthlyVolume Int?
  intent        String?  // informational, transactional, navigational
  targetUrl     String?  // URL que rankea para esta keyword
  firstSeen     DateTime @default(now())
  lastSeen      DateTime @default(now())
  
  @@unique([competitorId, keyword])
  @@index([competitorId])
  @@index([keyword])
}

model SeoCompetitorRanking {
  id            String   @id @default(cuid())
  competitorId  String
  competitor    SeoCompetitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  keyword       String
  date          DateTime @db.Date
  position      Float
  url           String?
  createdAt     DateTime @default(now())
  
  @@unique([competitorId, keyword, date])
  @@index([competitorId, date])
  @@index([keyword])
}

